generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 Int      @id @default(autoincrement())
  clerkId            String   @unique // Link to Clerk
  phone              String?  @unique // Optional now, managed by Clerk
  email              String   @unique
  password           String?  // Optional, managed by Clerk
  role               String?  @default("VOLUNTEER") // "ORGANIZER" or "VOLUNTEER"
  name               String?
  photoUrl           String?
  idCardUrl          String?
  isVerified         Boolean  @default(false)
  emailVerified      Boolean  @default(true) // Handled by Clerk
  verificationToken  String?
  createdAt          DateTime @default(now())
  events             Event[]
  applications       Application[]
}

model Event {
  id          Int      @id @default(autoincrement())
  organizerId Int
  organizer   User     @relation(fields: [organizerId], references: [id])
  title       String
  description String
  date        String
  time        String
  location    String
  payDetails  String
  requirements String
  status      String   @default("OPEN") // OPEN, CLOSED
  createdAt   DateTime @default(now())
  applications Application[]
}

model Application {
  id          Int      @id @default(autoincrement())
  eventId     Int
  event       Event    @relation(fields: [eventId], references: [id])
  volunteerId Int
  volunteer   User     @relation(fields: [volunteerId], references: [id])
  status      String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  createdAt   DateTime @default(now())
}
